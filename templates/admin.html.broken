  $('adSaveBtn').style.display = 'none';
  $('adUpdateBtn').style.display = 'inline-block';
  $('adCancelBtn').style.display = 'inline-block';
  document.querySelector('#ads .card').scrollIntoView({behavior:'smooth'});
