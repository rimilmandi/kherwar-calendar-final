<!doctype html>
<html lang="bn">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Kherwar Calendar Admin</title>
<style>
:root{--p:#087f5b;--p2:#0b9b70;--gold:#d7a52a;--bg:#f3f7f5;--card:#fff;--text:#17352b;--muted:#687970;--line:#dce8e3;--danger:#c62828}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,"Noto Sans Bengali",sans-serif}
.top{background:linear-gradient(135deg,var(--p),var(--p2));color:#fff;padding:15px}
.topin{max-width:1250px;margin:auto;display:flex;justify-content:space-between;align-items:center;gap:10px}
.top h1{margin:0;font-size:19px}.top p{margin:3px 0 0;font-size:12px;opacity:.85}
.wrap{max-width:1250px;margin:auto;padding:16px}
.tabs{display:flex;gap:7px;overflow:auto;padding-bottom:12px}
.tab{flex:none;border:1px solid var(--line);background:#fff;border-radius:999px;padding:10px 14px;font-weight:800;white-space:nowrap;cursor:pointer}
.tab.active{background:var(--p);color:#fff}
.panel{display:none}.panel.active{display:block}
.card{background:#fff;border:1px solid var(--line);border-radius:17px;padding:17px;margin-bottom:14px;box-shadow:0 7px 24px #1231}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
label{display:block;font-size:12px;font-weight:800;color:var(--muted);margin:9px 0 5px}
input,select,textarea{width:100%;padding:10px;border:1px solid var(--line);border-radius:10px;font:inherit}
textarea{min-height:90px}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.btn{border:0;border-radius:10px;padding:10px 13px;font-weight:800;cursor:pointer;text-decoration:none;display:inline-block}
.primary{background:var(--p);color:#fff}
.secondary{background:#e8f3ee;color:var(--p)}
.gold{background:#fff1c9;color:#725400}
.danger{background:#fdeaea;color:var(--danger)}
.table{overflow:auto;border:1px solid var(--line);border-radius:11px;margin-top:12px}
.table table{border-collapse:collapse;width:100%;min-width:760px}
.table th,.table td{padding:8px;border-bottom:1px solid var(--line);font-size:12px;text-align:left;vertical-align:top}
.table th{background:#f7faf9;color:var(--muted)}
.kpi{display:grid;grid-template-columns:repeat(5,1fr);gap:9px}
.k{background:#f8fbfa;border:1px solid var(--line);border-radius:13px;padding:12px}
.k b{font-size:20px}.k span{display:block;font-size:11px;color:var(--muted)}
.status{display:none;background:#e8f7f1;color:#086d51;padding:10px;border-radius:10px;margin-bottom:12px;font-size:12px;font-weight:800}
.preview{width:100%;height:680px;border:1px solid var(--line);border-radius:12px}
.img-preview{display:inline-block;margin-left:10px;vertical-align:middle}
.img-preview img{width:52px;height:52px;object-fit:cover;border-radius:8px;border:1px solid var(--line);background:#f5f5f5}
.row-actions{display:flex;gap:5px;flex-wrap:wrap}
@media(max-width:850px){.grid,.grid3{grid-template-columns:1fr}.kpi{grid-template-columns:repeat(2,1fr)}.top h1{font-size:16px}}
</style>
</head>
<body>
<header class="top">
  <div class="topin">
    <div><h1>☀ Kherwar Calendar — Admin</h1><p>Database-connected Calendar CMS</p></div>
    <div>{% if request.user.is_authenticated %}✓ {{ request.user.username }} · <a style="color:#fff" href="/logout/">Logout</a>{% endif %}</div>
  </div>
</header>
<main class="wrap">
  <div id="status" class="status"></div>
  <nav class="tabs">
    <button class="tab active" data-p="dashboard">Dashboard</button>
    <button class="tab" data-p="months">🌙 Months</button>
    <button class="tab" data-p="history">📜 1900–2024</button>
    <button class="tab" data-p="events">🎉 Lunar Events</button>
    <button class="tab" data-p="solar">☀ Solar Events</button>
    <button class="tab" data-p="ads">📢 Ads</button>
    <button class="tab" data-p="settings">🎨 UI</button>
    <button class="tab" data-p="preview">👁 Preview</button>
  </nav>

  <!-- ================= DASHBOARD ================= -->
  <section id="dashboard" class="panel active">
    <div class="card">
      <h2>Database Dashboard</h2>
      <div class="kpi">
        <div class="k"><b id="kh">0</b><span>Historical</span></div>
        <div class="k"><b id="km">0</b><span>New Moon</span></div>
        <div class="k"><b id="ke">0</b><span>Lunar Events</span></div>
        <div class="k"><b id="ks">0</b><span>Solar Events</span></div>
        <div class="k"><b id="ka">0</b><span>Ads</span></div>
      </div>
      <div class="actions">
        <button class="btn primary" onclick="loadDB()">↻ Sync Database</button>
        <a class="btn secondary" href="/django-admin/">Django Admin</a>
        <a class="btn gold" href="/">Open Calendar</a>
      </div>
    </div>
    <div class="card">
      <h3>Database workflow</h3>
      <p style="font-size:12px;line-height:1.7;color:var(--muted)">
        New Moon → Month order → পরের দিন থেকে Lunar Day 1 → Historical override (1900–2024) → Lunar/Solar Event → Calendar UI.
        13th month হলে সেই বছরের New Moon entry-তে month order = 6 (বা আপনার নির্ধারিত ক্রম) দিন।
      </p>
    </div>
  </section>

  <!-- ================= MONTHS ================= -->
  <section id="months" class="panel">
    <div class="card">
      <h2>🌙 Santali 12/13 Months</h2>
      <div class="table">
        <table>
          <thead><tr><th>#</th><th>Ol Chiki</th><th>English</th><th>Extra</th><th>Action</th></tr></thead>
          <tbody id="monthsRows"></tbody>
        </table>
      </div>
      <div class="actions"><button class="btn primary" onclick="addMonth()">+ Month</button></div>
      <h3>New Moon</h3>
      <div class="grid3">
        <div><label>Gregorian date</label><input id="moonDate" type="date"></div>
        <div><label>Santali year</label><input id="moonYear" type="number"></div>
        <div><label>New moon-এর পরের মাসের order</label><input id="moonOrder" type="number" min="1" max="13"></div>
      </div>
      <label>Note</label><input id="moonNote">
      <button class="btn primary" style="margin-top:10px" onclick="saveMoon()">Save New Moon</button>
      <div class="actions">
        <button class="btn secondary" onclick="exportCSV('moon')">Export Moon CSV</button>
        <button class="btn secondary" onclick="document.getElementById('moonCSV').click()">Import Moon CSV</button>
        <input id="moonCSV" type="file" accept=".csv" hidden>
      </div>
      <div class="table">
        <table>
          <thead><tr><th>Date</th><th>Year</th><th>Month order</th><th>Action</th></tr></thead>
          <tbody id="moonRows"></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ================= HISTORY ================= -->
  <section id="history" class="panel">
    <div class="card">
      <h2>📜 Historical Date Database — 1900–2024</h2>
      <div class="grid3">
        <div><label>Gregorian *</label><input id="hDate" type="date" min="1900-01-01" max="2024-12-31"></div>
        <div><label>বাংলা দিন</label><input id="hbD" type="number"></div>
        <div><label>বাংলা মাস</label><input id="hbM"></div>
        <div><label>বাংলা বছর</label><input id="hbY" type="number"></div>
        <div><label>সাঁওতালি দিন</label><input id="hsD" type="number"></div>
        <div><label>সাঁওতালি মাস</label><input id="hsM"></div>
        <div><label>সাঁওতালি বছর</label><input id="hsY" type="number"></div>
        <div><label>Source / Note</label><input id="hn"></div>
      </div>
      <button class="btn primary" style="margin-top:10px" onclick="saveHistory()">Save Historical Date</button>
      <div class="actions">
        <button class="btn secondary" onclick="exportCSV('history')">Export Historical CSV</button>
        <button class="btn secondary" onclick="document.getElementById('historyCSV').click()">Import Historical CSV</button>
        <input id="historyCSV" type="file" accept=".csv" hidden>
      </div>
      <div class="table">
        <table>
          <thead><tr><th>Gregorian</th><th>বাংলা</th><th>সাঁওতালি</th><th>Source</th><th>Action</th></tr></thead>
          <tbody id="historyRows"></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ================= LUNAR EVENTS ================= -->
  <section id="events" class="panel">
    <div class="card">
      <h2>🎉 Lunar Event</h2>
      <div class="grid3">
  <div>
    <label>Month (সাঁওতালি মাস)</label>
    <select id="em"></select>
  </div>
  <div>
    <label>Event type</label>
    <select id="ed_type" onchange="toggleDayInput()">
      <option value="lunar_day">Lunar Day (সাধারণ দিন)</option>
      <option value="full_moon">🌕 Full Moon (পূর্ণিমা)</option>
      <option value="new_moon">🌑 New Moon (অমাবস্যা)</option>
    </select>
  </div>
  <div id="ed_day_wrap">
    <label>Lunar day</label>
    <input id="ed" type="number" min="1" max="35">
  </div>
</div>
<div class="grid3">
  <div><label>Title *</label><input id="et"></div>
</div>
      <div class="grid">
        <div><label>Details</label><textarea id="edesc"></textarea></div>
        <div>
          <label>Image URL</label>
          <input id="eimg" placeholder="/media/... বা https://..." oninput="previewImg('eimg','eimgPreview')">
          <input id="eimgFile" type="file" accept="image/*" hidden>
          <button type="button" class="btn secondary" onclick="$('eimgFile').click()">📁 Local Image</button>
          <span id="eimgPreview" class="img-preview" style="display:none">
            <img id="eimgPreviewImg" src="" alt="preview">
          </span>
          <label>Label</label><input id="elabel">
        </div>
      </div>
      <div class="actions">
        <button id="eventSaveBtn" class="btn primary" onclick="saveEvent()">Save Event</button>
        <button id="eventUpdateBtn" class="btn gold" style="display:none" onclick="updateEvent()">Update Event</button>
        <button id="eventCancelBtn" class="btn secondary" style="display:none" onclick="cancelEventEdit()">Cancel Edit</button>
      </div>
      <div class="actions">
        <button class="btn secondary" onclick="exportCSV('event')">Export Events CSV</button>
        <button class="btn secondary" onclick="document.getElementById('eventCSV').click()">Import Events CSV</button>
        <input id="eventCSV" type="file" accept=".csv" hidden>
      </div>
      <div class="table">
        <table>
          <thead><tr><th>Month</th><th>Day</th><th>Title</th><th>Image</th><th>Action</th></tr></thead>
          <tbody id="eventRows"></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ================= SOLAR EVENTS ================= -->
  <section id="solar" class="panel">
    <div class="card">
      <h2>☀ Solar Year Special Days</h2>
      <div class="grid">
        <div><label>Date</label><input id="sd" type="date"></div>
        <div><label>Title</label><input id="st"></div>
        <div><label>Short description</label><input id="ss"></div>
        <div>
          <label>Image URL</label>
          <input id="si" placeholder="/media/... বা https://..." oninput="previewImg('si','siPreview')">
          <input id="siFile" type="file" accept="image/*" hidden>
          <button type="button" class="btn secondary" onclick="$('siFile').click()">📁 Local Image</button>
          <span id="siPreview" class="img-preview" style="display:none">
            <img id="siPreviewImg" src="" alt="preview">
          </span>
        </div>
      </div>
      <label>Detailed information</label><textarea id="sdet"></textarea>
      <div class="actions">
        <button id="solarSaveBtn" class="btn primary" onclick="saveSolar()">Save Solar Event</button>
        <button id="solarUpdateBtn" class="btn gold" style="display:none" onclick="updateSolar()">Update Solar Event</button>
        <button id="solarCancelBtn" class="btn secondary" style="display:none" onclick="cancelSolarEdit()">Cancel Edit</button>
      </div>
      <div class="table">
        <table>
          <thead><tr><th>Date</th><th>Title</th><th>Description</th><th>Image</th><th>Action</th></tr></thead>
          <tbody id="solarRows"></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ================= ADS ================= -->
  <section id="ads" class="panel">
    <div class="card">
      <h2>📢 Advertisement</h2>
      <p style="color:#666;margin-top:-6px">লোকাল Drive/PC থেকে ছবি বেছে নিলে server-এর <b>Image URL</b> নিজে তৈরি হবে। <b>Target URL</b>-এ ক্লিক করলে যে website খুলবে তার ঠিকানা দিন।</p>
      <div class="grid3">
        <div>
          <label>Slot</label>
          <select id="as">
            <option value="left_top">Left Top</option>
            <option value="right_top">Right Top</option>
            <option value="right_bottom">Right Bottom</option>
            <option value="featured">Featured</option>
          </select>
        </div>
        <div><label>Business</label><input id="ab"></div>
        <div><label>Priority</label><input id="ap" type="number" value="0"></div>
        <div>
          <label>Image URL</label>
          <input id="ai" placeholder="Upload করলে URL এখানে বসবে" oninput="previewImg('ai','aiPreview')">
          <input id="aiFile" type="file" accept="image/*" hidden>
          <button type="button" class="btn secondary" onclick="$('aiFile').click()">📁 Local Image</button>
          <span id="aiPreview" class="img-preview" style="display:none">
            <img id="aiPreviewImg" src="" alt="preview">
          </span>
        </div>
        <div><label>Target URL</label><input id="au" placeholder="https://business.example.com"></div>
        <div><label>Start</label><input id="ast" type="date"></div>
        <div><label>End</label><input id="aen" type="date"></div>
      </div>
      <div class="actions">
        <button id="adSaveBtn" class="btn primary" onclick="saveAd()">Save Advertisement</button>
        <button id="adUpdateBtn" class="btn gold" style="display:none" onclick="updateAd()">Update Advertisement</button>
        <button id="adCancelBtn" class="btn secondary" style="display:none" onclick="cancelAdEdit()">Cancel Edit</button>
      </div>
      <div class="table">
        <table>
          <thead><tr><th>Slot</th><th>Business</th><th>Period</th><th>Image</th><th>Action</th></tr></thead>
          <tbody id="adRows"></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ================= SETTINGS ================= -->
  <section id="settings" class="panel">
    <div class="card">
      <h2>🎨 UI Settings</h2>
      <div class="grid3">
        <div><label>Primary</label><input id="up" type="color"></div>
        <div><label>Secondary</label><input id="up2" type="color"></div>
        <div><label>Gold</label><input id="ug" type="color"></div>
      </div>
      <div class="grid">
        <div><label>Title</label><input id="ut"></div>
        <div><label>Subtitle</label><input id="us"></div>
      </div>
      <button class="btn primary" style="margin-top:10px" onclick="saveSettings()">Save UI Settings</button>
    </div>
  </section>

  <!-- ================= PREVIEW ================= -->
  <section id="preview" class="panel">
    <div class="card">
      <h2>👁 Live Calendar</h2>
      <iframe id="frame" class="preview"></iframe>
    </div>
  </section>
</main>

{% csrf_token %}

<script>
"use strict";
const API='/api/calendar/data/';
let D={months:[],newMoons:[],history:[],events:[],solarEvents:[],ads:[],settings:{}};
const $=id=>document.getElementById(id);

/* ============================================================
   Basic helpers
   ============================================================ */
function toast(x){
  $('status').textContent=x;
  $('status').style.display='block';
  clearTimeout(window.tt);
  window.tt=setTimeout(()=>$('status').style.display='none',2300);
}
function csrf(){return document.querySelector('[name=csrfmiddlewaretoken]')?.value||''}
async function req(kind,method,body){
  const r=await fetch(API+kind+'/',{
    method,
    credentials:'same-origin',
    headers:{'Content-Type':'application/json','X-CSRFToken':csrf()},
    body:body?JSON.stringify(body):undefined
  });
  const x=await r.json();
  if(!r.ok)throw Error(x.error||'Request failed');
  return x;
}
async function loadDB(){
  try{
    const r=await fetch('/api/calendar/bootstrap/',{credentials:'same-origin'});
    if(!r.ok)throw Error('Database read failed');
    D=await r.json();
    render();
    toast('Database synced');
  }catch(e){toast(e.message)}
}
function esc(v){
  return String(v??'').replace(/[&<>"']/g,c=>({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  }[c]));
}
function previewImg(inputId,boxId){
  const url = $(inputId).value.trim();
  const box = $(boxId);
  if(!box) return;
  const img = box.querySelector('img');
  if(url){
    img.src = url;
    box.style.display = 'inline-block';
  } else {
    box.style.display = 'none';
  }
}

/* ============================================================
   Render functions
   ============================================================ */
function render(){
  renderMonths();renderMoons();renderHistory();renderEvents();renderSolar();renderAds();
  $('up').value=D.settings.primary||'#087f5b';
  $('up2').value=D.settings.secondary||'#0b9b70';
  $('ug').value=D.settings.gold||'#d7a52a';
  $('ut').value=D.settings.title||'Kherwar Calendar';
  $('us').value=D.settings.subtitle||'Santali • Bengali • English';
  $('kh').textContent=D.history.length;
  $('km').textContent=D.newMoons.length;
  $('ke').textContent=D.events.length;
  $('ks').textContent=D.solarEvents.length;
  $('ka').textContent=D.ads.length;

    // ✅ Month dropdown পপুলেট করি (value = সাঁওতালি নাম, data-order = order)
  const ms = $('em');
  if(ms){
    ms.innerHTML = D.months
      .sort((a,b)=>a.order-b.order)
      .map(m => `<option value="${esc(m.olchiki_name)}" data-order="${m.order}">${m.order}. ${esc(m.olchiki_name)} — ${esc(m.english_name)}</option>`)
      .join('');
  }
  toggleDayInput();

/* ---------- Months ---------- */
function renderMonths(){
  $('monthsRows').innerHTML = D.months.map(m=>`<tr>
    <td>${m.order}</td>
    <td><input id="mn${m.id}" value="${esc(m.olchiki_name)}"></td>
    <td><input id="me${m.id}" value="${esc(m.english_name)}"></td>
    <td><input id="mx${m.id}" type="checkbox" ${m.is_extra?'checked':''}></td>
    <td><button class="btn primary" onclick="updateMonth(${m.id})">Save</button></td>
  </tr>`).join('');
}
async function updateMonth(id){
  const m=D.months.find(x=>x.id===id);
  try{
    await req('month','PUT',{
      id,
      order:m.order,
      olchiki_name:$('mn'+id).value,
      english_name:$('me'+id).value,
      is_extra:$('mx'+id).checked
    });
    await loadDB();
    toast('✅ Month updated');
  }catch(e){toast(e.message)}
}
async function addMonth(){
  if(D.months.length>=13)return toast('সর্বোচ্চ 13টি মাস');
  try{
    await req('month','POST',{order:D.months.length+1,olchiki_name:'',english_name:'',is_extra:true});
    await loadDB();
    toast('✅ Month added');
  }catch(e){toast(e.message)}
}

/* ---------- New Moon ---------- */
async function saveMoon(){
  try{
    await req('moon','POST',{
      date:$('moonDate').value,
      lunar_year:Number($('moonYear').value)||null,
      month_order:Number($('moonOrder').value)||null,
      note:$('moonNote').value
    });
    await loadDB();
    toast('✅ New Moon saved');
  }catch(e){toast(e.message)}
}
function renderMoons(){
  $('moonRows').innerHTML = D.newMoons.map(x=>`<tr>
    <td>${x.date}</td>
    <td>${x.lunar_year||''}</td>
    <td>${x.month_order||''}</td>
    <td><button class="btn danger" onclick="del('moon',${x.id})">Delete</button></td>
  </tr>`).join('');
}

/* ---------- History ---------- */
async function saveHistory(){
  const b={
    date:$('hDate').value,
    bDay:$('hbD').value,bMonth:$('hbM').value,bYear:$('hbY').value,
    sDay:$('hsD').value,sMonth:$('hsM').value,sYear:$('hsY').value,
    note:$('hn').value
  };
  try{
    await req('history','POST',b);
    await loadDB();
    toast('✅ Historical date saved');
  }catch(e){toast(e.message)}
}
function renderHistory(){
  $('historyRows').innerHTML = D.history.map(x=>`<tr>
    <td>${x.date}</td>
    <td>${esc([x.bDay,x.bMonth,x.bYear].filter(Boolean).join(' '))}</td>
    <td>${esc([x.sDay,x.sMonth,x.sYear].filter(Boolean).join(' '))}</td>
    <td>${esc(x.note)}</td>
    <td><button class="btn danger" onclick="del('history',${x.id})">Delete</button></td>
  </tr>`).join('');
}

/* ============================================================
   LUNAR EVENT — Save / Update / Edit / Cancel
   ============================================================ */
let editingEventId = null;
function toggleDayInput(){
  const type = $('ed_type') ? $('ed_type').value : 'lunar_day';
  const wrap = $('ed_day_wrap');
  if(!wrap) return;
  if(type === 'full_moon'){
    wrap.style.display = 'none';
    $('ed').value = 15;
  } else if(type === 'new_moon'){
    wrap.style.display = 'none';
    $('ed').value = 30;
  } else {
    wrap.style.display = 'block';
  }
}


async function saveEvent(){
  try{
    const sel = $('em').selectedOptions[0];
    const month_name = sel ? sel.value : '';
    const month_order = sel ? Number(sel.dataset.order) : null;
    await req('event','POST',{
      month: month_order,
      month_name: month_name,
      day:Number($('ed').value),
      title:$('et').value,
      description:$('edesc').value,
      image:$('eimg').value,
      label:$('elabel').value,
      event_type:$('ed_type').value
    });
    await loadDB();
    toast('✅ Event saved');
  }catch(e){toast(e.message)}
}

function editEvent(id){
  const x = D.events.find(v=>Number(v.id)===Number(id));
  if(!x) return;
  editingEventId = x.id;
  
  // ✅ সাঁওতালি নাম দিয়ে dropdown সিলেক্ট করি
  const sel = $('em');
  if(x.month_name){
    // month_name আছে → সেটা দিয়ে select
    sel.value = x.month_name;
  } else if(x.month){
    // পুরনো ডেটা → order দিয়ে find করে select
    const opt = Array.from(sel.options).find(o => Number(o.dataset.order) === Number(x.month));
    if(opt) sel.value = opt.value;
  }
  
  $('ed').value = x.day;
  $('et').value = x.title || '';
  $('edesc').value = x.description || '';
  $('eimg').value = x.image || '';
  $('elabel').value = x.label || '';
  if($('ed_type')) $('ed_type').value = x.event_type || 'lunar_day';
  toggleDayInput();
  if(typeof previewImg === 'function') previewImg('eimg','eimgPreview');
  toast('✏️ এডিট মোডে — Update চাপুন');
}

async function updateEvent(){
  if(!editingEventId) return toast('⚠️ আগে Edit বাটনে ক্লিক করুন');
  try{
    const sel = $('em').selectedOptions[0];
    const month_name = sel ? sel.value : '';
    const month_order = sel ? Number(sel.dataset.order) : null;
    await req('event','PUT',{
      id: editingEventId,
      month: month_order,
      month_name: month_name,
      day:Number($('ed').value),
      title:$('et').value,
      description:$('edesc').value,
      image:$('eimg').value,
      label:$('elabel').value,
      event_type:$('ed_type').value
    });
    editingEventId = null;
    resetEventForm();
    await loadDB();
    toast('✅ Event updated');
  }catch(e){toast(e.message)}
}

function resetEventForm(){
  ['em','ed','et','edesc','eimg','elabel'].forEach(id=>{ if($(id)) $(id).value=''; });
  const box = $('eimgPreview'); if(box) box.style.display = 'none';
  $('eventSaveBtn').style.display = 'inline-block';
  $('eventUpdateBtn').style.display = 'none';
  $('eventCancelBtn').style.display = 'none';
}
function cancelEventEdit(){
  editingEventId = null;
  resetEventForm();
  toast('Edit cancelled');
}

function renderEvents(){
  $('eventRows').innerHTML = D.events.map(x=>`<tr>
    <td>${esc(x.month_name || '')} ${x.month ? '<small style="color:#888">('+x.month+')</small>' : ''}</td>
    <td>${x.day} ${x.event_type === 'full_moon' ? '🌕' : x.event_type === 'new_moon' ? '🌑' : ''}</td>
    <td>${esc(x.title)}</td>
    <td>${x.image ? '<img src="'+esc(x.image)+'" style="width:50px;height:40px;object-fit:cover;border-radius:6px">' : '—'}</td>
    <td class="row-actions">
      <button class="btn secondary" onclick="editEvent(${x.id})">Edit</button>
      <button class="btn danger" onclick="del('event',${x.id})">Delete</button>
    </td>
  </tr>`).join('');
}

