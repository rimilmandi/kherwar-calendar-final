  if(!editingAdId) return toast('⚠️ আগে Edit বাটনে ক্লিক করুন');
  try{
    await req('ad','PUT',{
      id: editingAdId,
      slot:$('as').value,
      business_name:$('ab').value,
      image:$('ai').value,
      target_url:$('au').value,
      start_date:$('ast').value||null,
      end_date:$('aen').value||null,
      priority:Number($('ap').value)||0
    });
