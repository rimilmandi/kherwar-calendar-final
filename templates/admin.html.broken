  $('as').value = 'left_top';
  $('ap').value = 0;
  const box = $('aiPreview'); if(box) box.style.display = 'none';
  $('adSaveBtn').style.display = 'inline-block';
  $('adUpdateBtn').style.display = 'none';
  $('adCancelBtn').style.display = 'none';
