      <button class="btn secondary" onclick="editAd(${x.id})">Edit</button>
      <button class="btn danger" onclick="del('ad',${x.id})">Delete</button>
    </td>
  </tr>`).join('');
}

/* ============================================================
   UI Settings
   ============================================================ */
async function saveSettings(){
  for(const [key,value] of [
    ['primary',$('up').value],
    ['secondary',$('up2').value],
    ['gold',$('ug').value],
    ['title',$('ut').value],
    ['subtitle',$('us').value]
  ]){
    try{ await req('setting','POST',{key,value}) }
    catch(e){ return toast(e.message) }
  }
  await loadDB();
  toast('✅ UI Settings saved');
}

/* ============================================================
   Generic Delete
   ============================================================ */
async function del(k,id){
  if(!confirm('Delete this record?'))return;
  try{
    await req(k,'DELETE',{id});
    await loadDB();
    toast('✅ Deleted');
  }catch(e){toast(e.message)}
}

/* ============================================================
   Image upload
   ============================================================ */
async function uploadImage(inputId,targetId){
  const f=$(inputId).files[0]; if(!f) return;
  const fd=new FormData(); fd.append('image',f);
  try{
    const r=await fetch('/api/calendar/upload-image/',{
      method:'POST',
      credentials:'same-origin',
      headers:{'X-CSRFToken':csrf()},
      body:fd
    });
    const x=await r.json();
    if(!r.ok) throw Error(x.error||'Image upload failed');
    $(targetId).value = x.url;
    // auto preview
    if(targetId === 'eimg') previewImg('eimg','eimgPreview');
    if(targetId === 'si')   previewImg('si','siPreview');
    if(targetId === 'ai')   previewImg('ai','aiPreview');
    toast('Image uploaded: '+x.url);
  }catch(e){toast(e.message)}
}

$('eimgFile').onchange = () => uploadImage('eimgFile','eimg');
$('siFile').onchange   = () => uploadImage('siFile','si');
$('aiFile').onchange   = () => uploadImage('aiFile','ai');

/* ============================================================
   CSV Export / Import
   ============================================================ */
function exportCSV(kind){ window.location='/api/calendar/export/'+kind+'/' }

async function importCSV(kind,file){
  const fd=new FormData(); fd.append('file',file);
  const r=await fetch('/api/calendar/import/'+kind+'/',{
    method:'POST',
    credentials:'same-origin',
    headers:{'X-CSRFToken':csrf()},
    body:fd
  });
  const x=await r.json();
  if(!r.ok)throw Error(x.error||'Import failed');
  await loadDB();
  toast(`${x.count} rows imported`);
}
$('historyCSV').onchange = e => e.target.files[0] && importCSV('history',e.target.files[0]).catch(x=>toast(x.message));
$('moonCSV').onchange    = e => e.target.files[0] && importCSV('moon',e.target.files[0]).catch(x=>toast(x.message));
$('eventCSV').onchange   = e => e.target.files[0] && importCSV('event',e.target.files[0]).catch(x=>toast(x.message));

/* ============================================================
   Tab navigation
   ============================================================ */
document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{
  document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));
  document.querySelectorAll('.panel').forEach(x=>x.classList.remove('active'));
  b.classList.add('active');
  $(b.dataset.p).classList.add('active');
  if(b.dataset.p==='preview') $('frame').src='/?preview='+Date.now();
});

/* ============================================================
   Initial load
   ============================================================ */
loadDB();
</script>
</body>
</html>